<!DOCTYPE html>
<html lang="{{lang}}" {{#if isRtl}}dir="rtl"{{/if}}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{post.title}} - {{t.meta.title}}</title>
    <meta name="description" content="{{post.description}}">
    <meta name="keywords" content="{{post.keywords}}">
    <meta name="author" content="{{post.author}}">
    
    <!-- SEO and Language Tags -->
    <link rel="canonical" href="{{canonicalUrl}}/blog/{{post.slug}}">
    {{#each alternateUrls}}
    <link rel="alternate" hreflang="{{@key}}" href="{{this}}/blog/{{../post.slug}}">
    {{/each}}
    
    <!-- Open Graph -->
    <meta property="og:title" content="{{post.title}}">
    <meta property="og:description" content="{{post.description}}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{canonicalUrl}}/blog/{{post.slug}}">
    <meta property="og:image" content="{{#if post.image}}{{canonicalUrl}}{{post.image}}{{else}}https://www.logo.surf/favicon-512x512.png{{/if}}">
    <meta property="article:author" content="{{post.author}}">
    <meta property="article:published_time" content="{{post.date}}T00:00:00Z">
    {{#each post.tags}}
    <meta property="article:tag" content="{{this}}">
    {{/each}}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{post.title}}">
    <meta name="twitter:description" content="{{post.description}}">
    <meta name="twitter:image" content="{{#if post.image}}{{canonicalUrl}}{{post.image}}{{else}}https://www.logo.surf/favicon-512x512.png{{/if}}">
    <meta name="twitter:creator" content="@we_webmaster">
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{{post.title}}",
      "description": "{{post.description}}",
      "author": {
        "@type": "Person",
        "name": "{{post.author}}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Logo.Surf",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.logo.surf/favicon-512x512.png"
        }
      },
      "datePublished": "{{post.date}}T00:00:00Z",
      "dateModified": "{{post.date}}T00:00:00Z",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{canonicalUrl}}/blog/{{post.slug}}"
      },
      "image": "{{#if post.image}}{{canonicalUrl}}{{post.image}}{{else}}https://www.logo.surf/favicon-512x512.png{{/if}}",
      "keywords": "{{post.keywords}}"
    }
    </script>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="2048x2048" href="/favicon-2048x2048.png">
    <script defer data-domain="logo.surf" src="https://click.pageview.click/js/script.js"></script>
    <script>
      tailwind.config = {
          theme: {
              extend: {
                  colors: {
                      'theme': '#111827',
                      'theme-dark': '#020617',
                  }
              }
          }
      }
    </script>
    <style>
      body {
          font-family: 'Poppins', sans-serif;
          {{#if isRtl}}direction: rtl;{{/if}}
      }
      .base-button {
          background: #111827;
          color: white;
          padding: 8px 16px;
          border-radius: 4px;
          transition: all .3s ease;
      }
      .base-button:hover {
          background: #374151;
      }
      .prose {
        max-width: none;
      }
      .prose h2 {
        font-size: 1.875rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: #111827;
      }
      .prose h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: #111827;
      }
      .prose p {
        margin-bottom: 1.5rem;
        line-height: 1.75;
        color: #374151;
      }
      .prose ul {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
      }
      .prose li {
        margin-bottom: 0.5rem;
        line-height: 1.75;
        color: #374151;
      }
      .prose a {
        color: #111827;
        text-decoration: underline;
      }
      .prose a:hover {
        color: #020617;
      }
      .prose blockquote {
        border-left: 4px solid #e5e7eb;
        padding-left: 1rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: #6b7280;
      }
      .prose code {
        background-color: #f3f4f6;
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
      }
      .prose pre {
        background-color: #1f2937;
        color: #f9fafb;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
      }
      .prose pre code {
        background-color: transparent;
        padding: 0;
      }
      .prose strong {
        font-weight: 600;
        color: #111827;
      }
    </style>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <a href="/" class="text-2xl font-bold text-theme">Logo.Surf</a>
          <nav class="hidden md:flex space-x-6">
            <a href="/" class="text-gray-600 hover:text-theme transition-colors">{{#if t.nav.home}}{{t.nav.home}}{{else}}Home{{/if}}</a>
            <a href="/blog" class="text-gray-600 hover:text-theme transition-colors">{{#if t.nav.blog}}{{t.nav.blog}}{{else}}Blog{{/if}}</a>
          </nav>
        </div>
        <div class="language-switcher">
          <button id="languageToggle" class="flex items-center space-x-2 px-3 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
            <span>{{currentLanguageName}}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="languageDropdown" class="language-dropdown">
            {{#each languages}}
            <a href="/{{@key}}/blog/{{../post.slug}}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">{{name}}</a>
            {{/each}}
          </div>
        </div>
      </div>
    </header>

    <!-- Breadcrumb -->
    <nav class="max-w-4xl mx-auto px-4 py-4">
      <ol class="flex items-center space-x-2 text-sm text-gray-500">
        <li><a href="/" class="hover:text-theme">{{#if t.nav.home}}{{t.nav.home}}{{else}}Home{{/if}}</a></li>
        <li><span class="mx-2">/</span></li>
        <li><a href="/blog" class="hover:text-theme">{{#if t.nav.blog}}{{t.nav.blog}}{{else}}Blog{{/if}}</a></li>
        <li><span class="mx-2">/</span></li>
        <li class="text-gray-900">{{post.title}}</li>
      </ol>
    </nav>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-8">
      <article class="bg-white rounded-lg shadow-sm p-8">
        <!-- Article Header -->
        <header class="mb-8 pb-6 border-b border-gray-200">
          <h1 class="text-4xl font-bold text-gray-900 mb-4 leading-tight">{{post.title}}</h1>
          
          <div class="flex flex-wrap items-center text-sm text-gray-500 gap-4 mb-4">
            <div class="flex items-center">
              <span class="font-medium text-gray-700">{{#if t.blog.author}}{{t.blog.author}}{{else}}By{{/if}} {{post.author}}</span>
            </div>
            <time datetime="{{post.date}}">{{formatDate post.date}}</time>
            <span>{{post.readTime}}</span>
          </div>
          
          {{#if post.tags}}
          <div class="flex flex-wrap gap-2">
            {{#each post.tags}}
            <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </header>

        <!-- Article Content -->
        <div class="prose max-w-none">
          {{{post.content}}}
        </div>

        <!-- Article Footer -->
        <footer class="mt-12 pt-8 border-t border-gray-200">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-500">
              {{#if t.blog.publishedOn}}{{t.blog.publishedOn}}{{else}}Published on{{/if}} <time datetime="{{post.date}}">{{formatDate post.date}}</time>
            </div>
            <div class="flex space-x-4">
              <button onclick="window.history.back()" class="text-theme hover:text-theme-dark transition-colors">
                ← {{#if t.blog.back}}{{t.blog.back}}{{else}}Back{{/if}}
              </button>
              <a href="/blog" class="text-theme hover:text-theme-dark transition-colors">
                {{#if t.blog.allPosts}}{{t.blog.allPosts}}{{else}}All Posts{{/if}}
              </a>
            </div>
          </div>
        </footer>
      </article>

      <!-- Back to Blog Button -->
      <div class="mt-8 text-center">
        <a href="/blog" class="base-button inline-flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {{#if t.blog.backToBlog}}{{t.blog.backToBlog}}{{else}}Back to Blog{{/if}}
        </a>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="text-center">
          <p class="text-gray-600">© 2025 Logo.Surf. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      // Language switcher functionality
      document.getElementById('languageToggle').addEventListener('click', function() {
        const dropdown = document.getElementById('languageDropdown');
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        const switcher = document.querySelector('.language-switcher');
        const dropdown = document.getElementById('languageDropdown');
        if (!switcher.contains(event.target)) {
          dropdown.style.display = 'none';
        }
      });
    </script>
  </body>
</html>