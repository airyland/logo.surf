---
import BlogIndexPage from '../components/BlogIndexPage.astro';
import BlogPostPage from '../components/BlogPostPage.astro';
import GradientFaviconPage from '../components/GradientFaviconPage.astro';
import HomePage from '../components/HomePage.astro';
import { getPageEntries, routeParamFromPathname } from '../lib/site.mjs';

export function getStaticPaths() {
  return getPageEntries()
    .filter((page) => page.pathname !== '/')
    .map((page) => ({
      params: { slug: routeParamFromPathname(page.pathname) },
      props: { kind: page.kind, pageProps: page.props },
    }));
}

const { kind, pageProps } = Astro.props;
---

{kind === 'home' && <HomePage {...pageProps} />}
{kind === 'blog-index' && <BlogIndexPage {...pageProps} />}
{kind === 'blog-post' && <BlogPostPage {...pageProps} />}
{kind === 'gradient-favicon' && <GradientFaviconPage {...pageProps} />}
